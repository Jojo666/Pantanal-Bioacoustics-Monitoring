       \"low_energy\":  band_energy(y, sr, 0, 1000),\n        \"mid_energy\":  band_energy(y, sr, 1000, 4000),\n        \"high_energy\": band_energy(y, sr, 4000, 16000),\n    })\n\nband_df = pd.DataFrame(records)\n\nfig, axes = plt.subplots(1, 3, figsize=(18, 4))\nfor ax, col, label in zip(axes,\n    [\"low_energy\", \"mid_energy\", \"high_energy\"],\n    [\"Low (0–1kHz)\", \"Mid (1–4kHz)\", \"High (4–16kHz)\"]):\n    band_df.groupby(\"hour\")[col].mean().plot(kind=\"bar\", ax=ax, color=BLUE, edgecolor=\"white\")\n    ax.set_title(f\"{label} energy by hour\", fontweight=\"bold\")\n    ax.set_xlabel(\"Hour\")\n    ax.set_ylabel(\"Mean STFT magnitude\")\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-11T12:41:28.752315Z","iopub.execute_input":"2026-04-11T12:41:28.752682Z","iopub.status.idle":"2026-04-11T12:41:32.567890Z","shell.execute_reply.started":"2026-04-11T12:41:28.752653Z","shell.execute_reply":"2026-04-11T12:41:32.566753Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1800x400 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"cell_type":"code","source":"# ── 6i. Labeled vs unlabeled windows — do labeled segments \n#        look spectrally different from background? ──────────\n# Pick one soundscape that appears in train_soundscapes_labels\n\nlabeled_files = labels_df[\"filename\"].unique()\n# Find the matching path\nmatch = next((p for p in soundscape_files \n              if Path(p).name in labeled_files), None)\n\nif match:\n    y, sr = librosa.load(match, sr=32000, mono=True)\n    file_labels = labels_df[labels_df[\"filename\"] == Path(match).name]\n    \n    # Pick first labeled segment and a gap segment\n    row = file_labels.iloc[0]\n    start_s = pd.to_timedelta(row[\"start\"]).total_seconds()\n    end_s   = pd.to_timedelta(row[\"end\"]).total_seconds()\n    \n    seg_labeled = y[int(start_s*sr):int(end_s*sr)]\n    seg_bg      = y[int(30*sr):int