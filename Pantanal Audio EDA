oundscapes per recorder site\", fontweight=\"bold\")\naxes[1].set_xlabel(\"Site\")\n\n# Date spread\nsc_meta[\"date\"].value_counts().sort_index().plot(\n    kind=\"bar\", ax=axes[2], color=BLUE, edgecolor=\"white\"\n)\naxes[2].set_title(\"Soundscapes by date\", fontweight=\"bold\")\naxes[2].set_xlabel(\"Date\")\naxes[2].tick_params(axis=\"x\", rotation=45)\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-11T12:40:52.464215Z","iopub.execute_input":"2026-04-11T12:40:52.464600Z","iopub.status.idle":"2026-04-11T12:40:57.779261Z","shell.execute_reply.started":"2026-04-11T12:40:52.464570Z","shell.execute_reply":"2026-04-11T12:40:57.778229Z"}},"outputs":[{"name":"stdout","text":"  site      date  hour  minute                               filename\n0  S08  20250606     3       0  BC2026_Train_0001_S08_20250606_030007\n1  S08  20250607     3       0  BC2026_Train_0002_S08_20250607_030007\n2  S08  20250607     7       0  BC2026_Train_0003_S08_20250607_070007\n3  S08  20250607     7       0  BC2026_Train_0004_S08_20250607_070007\n4  S08  20250607     7       0  BC2026_Train_0005_S08_20250607_070007\n\nSites: 23 unique\nDate range: 20140107 → 20251129\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1800x400 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":12},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── 6g. Spectrogram grid — 9 random soundscapes ──────────────\n# Quickly see if the insect-band is consistent or site/time-specific\nimport random\nrandom.seed(42)\nsample_sc = random.sample(soundscape_files, min(9, len(soundscape_files)))\n\nfig, axes = plt.subplots(3, 3, figsize=(18, 10))\naxes = axes.flatten()\n\nfor i, path in enumerate(sample_sc):\n    y, sr = librosa.load(path, sr=32000, mono=True, duration=10)  # first 10s only\n    S = librosa.feature.melspectrogram(y=y, s